#! /usr/bin/env python
# encoding: utf-8

# Decay server. Whole-tree substitution of the Decay hlsdk-portable fork,
# built from its own headers only, so no DECAY gates exist anywhere.

def options(opt):
	return

def configure(conf):
	return

def build(bld):
	# upstream Decay wscript's source set
	source = bld.path.ant_glob('**/*.cpp', excl=['mpstubb.cpp', 'stats.cpp', 'Wxdebug.cpp'])
	source += bld.path.parent.ant_glob([
		'pm_shared/*.c',
		'public/safe_snprintf.c',
		'game_shared/voice_gamemgr.cpp',
	])

	if not bld.env.HAVE_STRLCPY:
		source += bld.path.parent.ant_glob('external/openbsd/strlcpy.c')

	if not bld.env.HAVE_STRLCAT:
		source += bld.path.parent.ant_glob('external/openbsd/strlcat.c')

	# mod_options.txt ON options plus Decay's root wscript GCC defines; the
	# multiplay rules use CVoiceGameMgr, so NO_VOICEGAMEMGR is not defined
	defines = [
		'CLIENT_WEAPONS',
		'CROWBAR_FIX_RAPID_CROWBAR',
		'SPEAKABLE_TARGETS',
		'HD_HUD_DEFAULT',
		'_LINUX',
		'LINUX',
		'stricmp=strcasecmp',
		'strnicmp=strncasecmp',
		'_snprintf=snprintf',
		'_vsnprintf=vsnprintf',
	]

	includes = [
		'.',
		'../common',
		'../engine',
		'../pm_shared',
		'../game_shared',
		'../public',
		'decay',
	]

	# save/restore and keyvalue code pun fields through raw casts like stock GoldSrc
	flags = ['-fno-strict-aliasing']

	# one merged relocatable object means one 64KB PPC64 .toc, same as gearbox
	if bld.env.DEST_OS == 'ps3':
		flags += ['-mminimal-toc']

	# Decay's root wscript adds these for GCC C++; no -fno-rtti, xshlib renames the CNotepad groups
	cxxflags = flags + ['-fno-exceptions', '-Wno-invalid-offsetof']

	bld.shlib(
		source   = source,
		target   = 'server',
		name     = 'server',
		features = 'c cxx',
		includes = includes,
		defines  = defines,
		cflags   = flags,
		cxxflags = cxxflags,
		use      = ['vcs_info', 'werror', 'yy_thunks'],
		install_path = None,
		idx = bld.get_taskgen_count()
	)
