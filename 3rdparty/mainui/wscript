from waflib import Logs, Configure
import os

top = '.'

FT2_CHECK='''extern "C" {
#include <ft2build.h>
#include FT_FREETYPE_H
}

int main() { return FT_Init_FreeType( NULL ); }
'''

def options(opt):
	grp = opt.add_option_group('MainUI C++ options')
	grp.add_option('--enable-stbtt', action = 'store_true', dest = 'USE_STBTT', default = False,
		help = 'prefer stb_truetype.h over freetype [default: %(default)s]')

	return

def configure(conf):
	conf.load('fwgslib cxx11')
	conf.env.append_unique('DEFINES', 'STDINT_H=<cstdint>')

	if not conf.check_std('cxx11'):
		conf.define('MY_COMPILER_SUCKS', 1)

	if conf.env.DEST_OS in ['android', 'darwin', 'nswitch', 'psvita', 'emscripten'] or conf.env.MAGX:
		conf.options.USE_STBTT = True

	conf.define('MAINUI_USE_CUSTOM_FONT_RENDER', 1)

	nortti = {
		'msvc': ['/GR-'],
		'default': ['-fno-rtti']
	}

	conf.env.append_unique('CXXFLAGS', conf.get_flags_by_compiler(nortti, conf.env.COMPILER_CC))

	conf.define_cond('MAINUI_USE_STB', conf.options.USE_STBTT)

	if conf.env.DEST_OS == 'android':
		conf.define('NO_STL', 1)
		conf.env.append_unique('CXXFLAGS', '-fno-exceptions')

	# PS3 takes NEITHER TTF backend, so FontManager falls straight through to
	# CBitmapFont. That is already the only font that ever renders here: the
	# .ttf files live in extras.pk3, which the PKG does not ship, so
	# CFreeTypeFont::Create fails and the manager falls back to the bitmap font
	# anyway. Two things are won by not asking in the first place --
	#  1) ~4-5s of boot. Each failed gfx/fonts/*.ttf lookup walks every
	#     searchpath, LV2 file ops are high-latency, and LoadFontDataFile
	#     (FontManager.cpp) only caches HITS -- so the 6 Trebuchet requests +
	#     1 Tahoma each re-scan from scratch. Measured on hardware in three
	#     boot logs 2026-08-02.
	#  2) libfreetype drops out of the static link entirely.
	# Shipping the fonts instead was tried on hardware the same day and made
	# all menu text invisible -- see packaging/ps3/README.md. Re-enable this
	# only after TTF rendering actually works under ref_gl/ps3gl.
	if conf.env.DEST_OS in ['win32', 'dos', 'ps3']:
		pass
	else:
		if not conf.options.USE_STBTT and not conf.options.LOW_MEMORY:
			if conf.env.DEST_OS == 'ps3':
				# PS3 is a fully-static link target (no shared libs, whole
				# process is one ELF) -- ps3dev's prebuilt libfreetype.a was
				# built with gzip support and needs zlib (freetype2.pc has
				# `Libs.private: -lz`), but pkg-config only emits
				# Libs.private when asked for a --static link; plain
				# `--cflags --libs` silently drops it, which only bites here
				# because there's no dynamic linker to resolve the
				# transitive dependency at load time like on desktop
				# platforms. Confirmed via a real Docker build: omitting
				# --static fails with "undefined reference to
				# inflateInit2_/inflateEnd/inflateReset/inflate" from
				# ftgzip.o at final link.
				conf.check_cfg(package='freetype2', args='--cflags --libs --static', uselib_store='FT2')
				conf.check_cxx(fragment=FT2_CHECK, use='FT2', msg='Checking for \'freetype2\' sanity')
			else:
				conf.check_pkg('freetype2', 'FT2', FT2_CHECK)
			conf.define('MAINUI_USE_FREETYPE', 1)

def build(bld):
	source = bld.path.ant_glob([
		'*.cpp',
		'miniutl/*.cpp',
		'font/*.cpp',
		'menus/*.cpp',
		'menus/dynamic/*.cpp',
		'model/*.cpp',
		'controls/*.cpp'
	])

	includes = [
		'.',
		'miniutl/',
		'font/',
		'controls/',
		'menus/',
		'model/',
		'sdk_includes/common',
		'sdk_includes/engine',
		'sdk_includes/public',
		'sdk_includes/pm_shared'
	]

	bld.shlib(
		source   = source,
		target   = 'menu',
		includes = includes,
		use      = 'werror FT2 GDI32 USER32 yy_thunks',
		install_path = bld.env.LIBDIR,
		cmake_skip = True
	)
